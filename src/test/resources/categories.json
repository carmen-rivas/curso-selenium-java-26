[
  { "name": "Bug en la aplicación",
    "matchedStatuses": ["failed"], "messageRegex": ".*" },
  { "name": "Elemento no encontrado — selector roto o cambio de UI",
    "matchedStatuses": ["broken"], "traceRegex": ".*NoSuchElementException.*" },
  { "name": "Timeout — timing o ambiente lento",
    "matchedStatuses": ["broken"], "traceRegex": ".*TimeoutException.*" },
  { "name": "Error de infraestructura — driver o ambiente",
    "matchedStatuses": ["broken"],
    "traceRegex": ".*WebDriverException.*|.*SessionNotCreatedException.*" }
]